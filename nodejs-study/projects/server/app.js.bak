app.get('/now', (req, res) => {
  const now = new Date().toLocaleString();
  res.send(`Current date and time: ${now}`);
});


app.get('/login', (req, res) => {
  res.sendFile(__dirname + '/views/login.html');
});


/* 

Wrong way to handle login, as it exposes credentials in the URL and is not secure.


app.get('/login/:username/:password', function(req, res) {
    const username = req.params.username;
    const password = req.params.password;

    console.log(`Received login attempt with username: ${username} and password: ${password}`);
    res.send(`Received login attempt with username: ${username} and password: ${password}`);

    //http://localhost:3000/login/admin/admin123
});
*/
app.get('/login/:username/:password', function(req, res) {
    const username = req.params.username;
    const password = req.params.password;

    if (username === 'admin' && password === 'admin123') {
        res.status(200).send('Login successful');
    } else {
        res.status(401).send('Invalid credentials');
    }
});

//to run manual ly: node app.js
